# Copy this file to config.local.env. It is loaded by launcher.py, never execute it as shell code.
# Default: no network, no model downloads.
EVOVID_HOME=
EVOVID_LLM_BASE_URL=http://127.0.0.1:8081/v1
EVOVID_LLM_MODEL=
EVOVID_LLM_API_KEY=
EVOVID_ALLOW_REMOTE_LLM=0
# For optional remote LLM, explicitly set consent to 1 and an HTTPS base URL.
# Never commit a filled credential file or .evovid/.

# Optional ComfyUI: only a trusted, reviewed, already-working local workflow.
# Custom nodes may perform network activity; review them before approving the hash.
EVOVID_COMFY_URL=http://127.0.0.1:8188
EVOVID_COMFY_WORKFLOW=
EVOVID_COMFY_WORKFLOW_SHA256=
